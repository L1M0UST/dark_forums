    "first_post_text_max_chars": 12000,
    "first_post_text_min_chars": 1200,
    "first_post_text_retry_reduction_ratio": 0.6
  },
  "clickhouse": {
    "base_url": "http://127.0.0.1:8123",
    "user": "default",
    "password": "",
    "database": "default",
    "table": "data_leak_darkforums",
    "cluster": "clickhouse_cluster",
    "timeout_seconds": 30,
    "backfill_missing_only": false
  },
  "run": {
    "dry_run": false,
    "max_rows": 0,
    "worker_count": 1,
    "log_llm_input": false,
    "log_llm_input_max_chars": 4000
  }
