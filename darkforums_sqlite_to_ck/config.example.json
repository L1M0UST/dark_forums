{
  "sqlite": {
    "db_path": "../data/darkforums.sqlite3",
    "batch_size": 50,
    "start_scraped_at": "",
    "start_url": ""
  },
  "qwen": {
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key": "YOUR_QWEN_API_KEY",
    "model": "qwen-plus",
    "temperature": 0.2,
    "timeout_seconds": 120,
    "max_retries": 3,
