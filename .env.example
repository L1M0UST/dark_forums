# DarkForums 站点配置
# - 站点入口（一般是 index.php）
DARKFORUMS_BASE_URL=https://darkforums.su/index.php

# - 登录账号/密码（请填写你自己的；不要把真实值提交到仓库）
DARKFORUMS_USERNAME=
DARKFORUMS_PASSWORD=

# - 可选：旧的单入口（保留兼容，不建议用；优先用 DARKFORUMS_FORUM_URLS）
DARKFORUMS_LEAKS_URL=

# - 抓取入口版块列表（用 | 分隔多个 Forum URL）
DARKFORUMS_FORUM_URLS=https://darkforums.su/Forum-Cracked-Tools|https://darkforums.su/Forum-Cracked-Accounts|https://darkforums.su/Forum-HackTheBox-TryHackMe|https://darkforums.su/Forum-Doxes|https://darkforums.su/Forum-Combolists|https://darkforums.su/Forum-Source-Codes|https://darkforums.su/Forum-Games|https://darkforums.su/Forum-Other-Leaks|https://darkforums.su/Forum-Stealer-Logs|https://darkforums.su/Forum-Databases

# - Playwright 代理（不需要代理可留空；示例为本地代理端口）
DARKFORUMS_PROXY_SERVER=http://127.0.0.1:7890

# - 是否仅抓“今天”的帖子（1=是，0=否）。
#   你现在用严格时间窗口（MAX_AGE_HOURS），建议保持 0。
DARKFORUMS_ONLY_TODAY=0

# - Forum 列表页排序参数（建议 started 倒序，便于按时间窗口提前停止翻页）
DARKFORUMS_FORUM_SORT_QUERY=sortby=started&order=desc&datecut=9999&prefix=0

# - 每个 Forum 最多翻多少页用于“发现新帖”（时间窗口越大/版块越活跃，越需要调大）
DARKFORUMS_MAX_PAGES_PER_FORUM=3

# - 严格时间窗口：仅发现/抓取最近 N 小时内的新帖（例如 6 表示最近 6 小时）
DARKFORUMS_MAX_AGE_HOURS=6

# - 回帖解锁模板（用 | 分隔）。触发“回复可见”时会随机挑一句回帖。
DARKFORUMS_REPLY_TEMPLATES=Thanks|Up|Good info, thanks

# - 是否无头运行（1=无头；0=有头，便于本地调试）
DARKFORUMS_HEADLESS=1

# - 单次运行的抓取上限（0=不限量；>0 则最多处理这么多条线程）
#   由于你每小时跑一次，设置 0 代表每小时不限量（仍会按 MAX_AGE_HOURS 过滤）。
DARKFORUMS_MAX_THREADS_PER_DAY=0


# 飞书推送（可选）
# - 1=开启推送；0=关闭推送
FEISHU_ENABLED=0

# - 飞书开放平台 App 凭证（请填写你自己的；不要把真实值提交到仓库）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# - 接收消息的群 chat_id（形如 oc_...）
FEISHU_CHAT_ID=

# - 每次运行最多成功推送多少条帖子（每条帖子一条消息，含 1 楼截图（若存在））
FEISHU_MAX_POSTS_PER_RUN=5
